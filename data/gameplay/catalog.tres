[sub_resource type="Resource" id="WaveDefinition_one"]
script = ExtResource("6_wave")
number = 1
enemy_profile_id = &"frenzied_pig"
boss = false
spawn_count = 1
spawn_interval = 1.0

[resource]
script = ExtResource("1_catalog")
schema_version = 1
globals = SubResource("GlobalConfig_bootstrap")
gems = Array[ExtResource("3_gem")]([SubResource("GemDefinition_amethyst"), SubResource("GemDefinition_aquamarine"), SubResource("GemDefinition_diamond"), SubResource("GemDefinition_emerald"), SubResource("GemDefinition_opal"), SubResource("GemDefinition_ruby"), SubResource("GemDefinition_sapphire"), SubResource("GemDefinition_topaz")])
recipes = Array[ExtResource("4_recipe")]([SubResource("RecipeDefinition_silver"), SubResource("RecipeDefinition_fixture_advanced"), SubResource("RecipeDefinition_fixture_secret")])
enemy_profiles = Array[ExtResource("5_enemy")]([SubResource("EnemyProfileDefinition_pig")])
waves = Array[ExtResource("6_wave")]([SubResource("WaveDefinition_one")])
